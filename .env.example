# Copy to .env and adjust. Local Postgres from docker-compose.yml (port 5433)
DATABASE_URL="postgresql://campusbuzz:campusbuzz_dev@localhost:5433/campusbuzz?schema=public"
# Signs session cookies. Generate one: node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
AUTH_SECRET="replace-me-with-a-long-random-string"

# Optional — enables Claude-powered features (merch studio AI design, receipt scanning, copilot).
# Without it every AI feature falls back to its offline mode.
# ANTHROPIC_API_KEY=""

# Your own Master Admin login (created by `npm run db:seed` or `npm run admin:master`).
# Keep real values in .env only — never commit them.
MASTER_ADMIN_EMAIL=
MASTER_ADMIN_PASSWORD=
MASTER_ADMIN_NAME=
